#!/usr/bin/env bash
set -euo pipefail

# MCP launcher for codex-bridge (stdio). Harnesses start it through
# mcps/_shared/bin/run codex-bridge. Resolves node explicitly: GUI-launched
# MCP servers inherit a minimal PATH. Resolves its own realpath so the link at
# src/codex-bridge/bin/codex-bridge-mcp resolves to this folder.
SCRIPT_DIR="$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")"
# Started by mcps/_shared/bin/run: $1 is the profile.
[[ -n "${MCP_PROFILE:-}" ]] && shift
. "${SCRIPT_DIR}/../../../src/lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
exec "$NODE" "${SCRIPT_DIR}/server.mjs" "$@"
