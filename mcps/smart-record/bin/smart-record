#!/usr/bin/env bash
set -euo pipefail

# Command line for the smart-record engine (see ../src/cli.mjs for commands).
# Resolves node explicitly: GUI-launched processes inherit a minimal PATH.
# Resolves its own realpath so links onto PATH resolve to this folder.
SCRIPT_DIR="$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")"
. "${SCRIPT_DIR}/../../../src/lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
. "${SCRIPT_DIR}/../src/lib/reader-dependencies.sh"
exec "$NODE" "${SCRIPT_DIR}/../src/cli.mjs" "$@"
