#!/usr/bin/env bash
set -euo pipefail

# Launcher for the classifier (MCP server by default, `cli ...` for the CLI).
# One launcher for every harness: the ZDR harness, Claude Code, Codex, Cursor
# and the shell. It always uses the Kickoff ZDR OpenAI key, read from the
# harness secrets file, and starts node with an empty environment so an
# inherited OPENAI_API_KEY (a personal org) can never reach it. The scope
# decides where jobs live: inside the harness (its HOME is ~/.zdr-harness/home)
# jobs stay in ~/.zdr-harness; anywhere else they go to ~/.local/state.
# See ../README.md.
# PHI routing (src/lib/route.mjs). This runs first, before anything is
# sourced or set, so it judges exactly the environment the caller passed.
# node starts with an emptied environment, so the caller's environment is
# judged here. Names only, never values, are passed on: any ZDR_* / *_ZDR_* /
# OPENCODE_* variable in any case (what the ZDR harness sets), or any
# variable whose value mentions .zdr-harness, or resolves (symlinks, `..`)
# into it. The service's own key name and CLASSIFIER_* settings are not
# signals. ENV_CHECKED proves this ran; node treats a launch without it as
# "cannot evaluate" (PHI).
_cls_real() { # prints the resolved path of an existing file or directory
  local p="$1"
  if [[ -d "$p" ]]; then (cd -P -- "$p" 2>/dev/null && pwd -P)
  elif [[ -e "$p" ]]; then local d; d="$(cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd -P)" && printf '%s/%s\n' "$d" "$(basename -- "$p")"
  fi
}
ENV_SIGNALS=""
while IFS= read -r _cls_name; do
  case "$_cls_name" in
    KICKOFF_OPENAI_ZDR_API_KEY | CLASSIFIER_*) continue ;;
  esac
  _cls_value="${!_cls_name-}"
  shopt -s nocasematch
  if [[ "$_cls_name" =~ (^|_)ZDR(_|$) || "$_cls_name" == OPENCODE_* ]]; then
    ENV_SIGNALS+="${ENV_SIGNALS:+,}${_cls_name}"
  elif [[ "$_cls_value" == *".zdr-harness"* ]]; then
    ENV_SIGNALS+="${ENV_SIGNALS:+,}${_cls_name}"
  elif [[ "$_cls_value" == /* && "$_cls_value" != *$'\n'* && ${#_cls_value} -lt 4096 && -e "$_cls_value" && "$(_cls_real "$_cls_value")" == *"/.zdr-harness"* ]]; then
    ENV_SIGNALS+="${ENV_SIGNALS:+,}${_cls_name}"
  fi
done < <(compgen -e)
shopt -u nocasematch
unset _cls_name _cls_value
ENV_CHECKED=1

# The scope follows the resolved HOME, so a trailing slash, `..` or a symlink
# to the harness home still counts as the harness.
HOME_REAL="$(_cls_real "$HOME")"
HOME_REAL="${HOME_REAL:-$HOME}"
HOME_REAL="${HOME_REAL%/}"
if [[ "$HOME_REAL" == */.zdr-harness/home || "${HOME%/}" == */.zdr-harness/home ]]; then
  SCOPE=zdr
  if [[ "$HOME_REAL" == */.zdr-harness/home ]]; then REAL_HOME="${HOME_REAL%/.zdr-harness/home}"; else REAL_HOME="${HOME%/}"; REAL_HOME="${REAL_HOME%/.zdr-harness/home}"; fi
else
  SCOPE=local
  REAL_HOME="$HOME"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(cd "${SCRIPT_DIR}/../../.." && pwd -P)"
. "${REPO}/src/lib/resolve-binary.sh"
. "${REPO}/src/lib/read-env.sh"

# Started by mcps/_shared/bin/run: $1 is the profile, not "cli".
[[ -n "${MCP_PROFILE:-}" ]] && shift

ENV_FILE="${REPO}/apps/zdr-agent/.env"
[[ -f "$ENV_FILE" ]] || ENV_FILE="${REAL_HOME}/.zdr-harness/.env"
KEY="$(ENV_FILE="$ENV_FILE" env_get KICKOFF_OPENAI_ZDR_API_KEY)" || {
  echo "classifier: KICKOFF_OPENAI_ZDR_API_KEY is missing from the ZDR harness secrets file" >&2
  exit 1
}
NODE="$(resolve_binary node)"

ENTRY="${SCRIPT_DIR}/server.mjs"
if [[ "${1:-}" == cli ]]; then
  shift
  ENTRY="${SCRIPT_DIR}/cli.mjs"
fi

exec env -i \
  HOME="$HOME" \
  PATH=/usr/bin:/bin \
  TMPDIR="${TMPDIR:-/tmp}" \
  LANG=en_US.UTF-8 \
  CLASSIFIER_OPENAI_KEY="$KEY" \
  CLASSIFIER_SCOPE="$SCOPE" \
  CLASSIFIER_REAL_HOME="$REAL_HOME" \
  CLASSIFIER_ENV_CHECKED="$ENV_CHECKED" \
  ${ENV_SIGNALS:+CLASSIFIER_ENV_SIGNALS="$ENV_SIGNALS"} \
  ${CLASSIFIER_PHI:+CLASSIFIER_PHI="$CLASSIFIER_PHI"} \
  ${CLASSIFIER_ROUTE:+CLASSIFIER_ROUTE="$CLASSIFIER_ROUTE"} \
  ${CLASSIFIER_STAGE2:+CLASSIFIER_STAGE2="$CLASSIFIER_STAGE2"} \
  ${CLASSIFIER_SUB_STAGE1:+CLASSIFIER_SUB_STAGE1="$CLASSIFIER_SUB_STAGE1"} \
  ${CLASSIFIER_CODEX_MODEL:+CLASSIFIER_CODEX_MODEL="$CLASSIFIER_CODEX_MODEL"} \
  ${CLASSIFIER_CODEX_EFFORT:+CLASSIFIER_CODEX_EFFORT="$CLASSIFIER_CODEX_EFFORT"} \
  ${CLASSIFIER_CODEX_BATCH:+CLASSIFIER_CODEX_BATCH="$CLASSIFIER_CODEX_BATCH"} \
  ${CLASSIFIER_CODEX_PARALLEL:+CLASSIFIER_CODEX_PARALLEL="$CLASSIFIER_CODEX_PARALLEL"} \
  ${CLASSIFIER_CODEX_ENGINE:+CLASSIFIER_CODEX_ENGINE="$CLASSIFIER_CODEX_ENGINE"} \
  ${CLASSIFIER_CODEX_APP_SERVERS:+CLASSIFIER_CODEX_APP_SERVERS="$CLASSIFIER_CODEX_APP_SERVERS"} \
  ${CLASSIFIER_CODEX_APP_TIER:+CLASSIFIER_CODEX_APP_TIER="$CLASSIFIER_CODEX_APP_TIER"} \
  ${CLASSIFIER_CODEX_APP_SHAPE:+CLASSIFIER_CODEX_APP_SHAPE="$CLASSIFIER_CODEX_APP_SHAPE"} \
  ${CLASSIFIER_CODEX_APP_BASE:+CLASSIFIER_CODEX_APP_BASE="$CLASSIFIER_CODEX_APP_BASE"} \
  ${CLASSIFIER_CODEX_APP_TIMEOUT_MS:+CLASSIFIER_CODEX_APP_TIMEOUT_MS="$CLASSIFIER_CODEX_APP_TIMEOUT_MS"} \
  ${CLASSIFIER_CODEX_APP_IDLE_MS:+CLASSIFIER_CODEX_APP_IDLE_MS="$CLASSIFIER_CODEX_APP_IDLE_MS"} \
  ${CLASSIFIER_RETENTION_DAYS:+CLASSIFIER_RETENTION_DAYS="$CLASSIFIER_RETENTION_DAYS"} \
  ${CLASSIFIER_JOBS_DIR:+CLASSIFIER_JOBS_DIR="$CLASSIFIER_JOBS_DIR"} \
  ${CLASSIFIER_PROFILES_DIR:+CLASSIFIER_PROFILES_DIR="$CLASSIFIER_PROFILES_DIR"} \
  ${CLASSIFIER_FAULTS:+CLASSIFIER_FAULTS="$CLASSIFIER_FAULTS"} \
  ${CLASSIFIER_DEBUG:+CLASSIFIER_DEBUG="$CLASSIFIER_DEBUG"} \
  ${CLASSIFIER_CANDIDATES:+CLASSIFIER_CANDIDATES="$CLASSIFIER_CANDIDATES"} \
  ${CLASSIFIER_BATCH:+CLASSIFIER_BATCH="$CLASSIFIER_BATCH"} \
  ${CLASSIFIER_WINDOW:+CLASSIFIER_WINDOW="$CLASSIFIER_WINDOW"} \
  ${CLASSIFIER_WINDOW_ABOVE:+CLASSIFIER_WINDOW_ABOVE="$CLASSIFIER_WINDOW_ABOVE"} \
  ${CLASSIFIER_TIER:+CLASSIFIER_TIER="$CLASSIFIER_TIER"} \
  ${CLASSIFIER_HINTS:+CLASSIFIER_HINTS="$CLASSIFIER_HINTS"} \
  ${CLASSIFIER_NO_CACHE:+CLASSIFIER_NO_CACHE="$CLASSIFIER_NO_CACHE"} \
  "$NODE" --no-warnings "$ENTRY" "$@"
