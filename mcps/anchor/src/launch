#!/usr/bin/env bash
set -euo pipefail
# Launcher for anchor's front end (the stdio MCP server), with the release
# settings. The front end starts the daemon on first use and hands it this
# environment, so these hold for real use:
# - state in ~/.local/state/mcps/anchor (ANCHOR_STATE_DIR overrides);
# - alerts as macOS notifications, silent (ANCHOR_ALERT_SOUND=on for sound);
# - fixers: the sandboxed headless fixer on the subscription, behind the code
#   review gate (ANCHOR_REVIEW stays on); gateway services get tickets and
#   alerts only (dispatch.mjs).
# Started by mcps/_shared/bin/run: $1 is the profile.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(cd "${SCRIPT_DIR}/../../.." && pwd -P)"
. "${REPO}/src/lib/resolve-binary.sh"
[[ -n "${MCP_PROFILE:-}" ]] && shift
NODE="$(resolve_binary node)"
export ANCHOR_ALERT_BACKEND="${ANCHOR_ALERT_BACKEND:-notify}"
export ANCHOR_DISPATCH_CMD="${ANCHOR_DISPATCH_CMD:-[\"${NODE}\",\"${SCRIPT_DIR}/fixer-headless.mjs\"]}"
unset ANCHOR_REVIEW ANCHOR_ALLOW_DESKTOP_FIXER ANCHOR_FIXER_SANDBOX
exec "$NODE" --no-warnings "${SCRIPT_DIR}/shim.mjs" "$@"
