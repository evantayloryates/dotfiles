#!/usr/bin/env bash
set -euo pipefail

# CLI for claude-driver: every MCP tool as a subcommand, plus preflight,
# probe, broker and install. See ../README.md. Resolves its own realpath so the
# compatibility link at src/claude-driver/bin/claude-driver lands here.
SCRIPT_DIR="$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")"
. "${SCRIPT_DIR}/../../../src/lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
exec "$NODE" "${SCRIPT_DIR}/../src/cli.mjs" "$@"
