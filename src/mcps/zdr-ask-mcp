#!/usr/bin/env bash
set -euo pipefail

# User-scoped zdr-ask MCP: lets Claude Code / Codex ask the local ZDR harness
# questions. Only the harness password is read, from ~/.zdr-harness/.env; the
# ZDR OpenAI key never reaches this process. See ../zdr-harness/README.md.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/../lib/resolve-binary.sh"
. "${SCRIPT_DIR}/../lib/read-env.sh"

NODE="$(resolve_binary node)"

# Secrets live beside the harness config; ~/.zdr-harness/.env is the fallback.
SECRETS_FILE="${SCRIPT_DIR}/../zdr-harness/.env"
[[ -f "$SECRETS_FILE" ]] || SECRETS_FILE="${HOME}/.zdr-harness/.env"

harness_env="$(ENV_FILE="$SECRETS_FILE" env_export ZDR_HARNESS_PASSWORD)"
eval "$harness_env"
unset harness_env
: "${ZDR_HARNESS_PASSWORD:?ZDR_HARNESS_PASSWORD must be set in ${SECRETS_FILE}}"
export ZDR_HARNESS_PASSWORD

exec "$NODE" "${SCRIPT_DIR}/zdr-ask/index.mjs"
