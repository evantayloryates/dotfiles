#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/../lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
package="${1:-}"
shift || true
case "$package" in
  gmail-mcp-multiauth)
    if [[ ! -f "$SCRIPT_DIR/runtime/gmail-fork/index.js" ]]; then echo "Gmail fork source missing" >&2; exit 69; fi
    exec "$NODE" "$SCRIPT_DIR/runtime/gmail-fork/index.js" "$@" ;;
  @notionhq/notion-mcp-server) entry="@notionhq/notion-mcp-server/bin/cli.mjs" ;;
  @cloudinary/asset-management-mcp) entry="@cloudinary/asset-management-mcp/bin/mcp-server.js" ;;
  *) echo "Unknown MCP package" >&2; exit 64 ;;
esac
if [[ ! -f "$SCRIPT_DIR/runtime/node_modules/$entry" ]]; then
  echo "MCP runtime missing. Run npm ci --prefix $SCRIPT_DIR/runtime --ignore-scripts --no-audit --no-fund" >&2
  exit 69
fi
exec "$NODE" "$SCRIPT_DIR/runtime/node_modules/$entry" "$@"
