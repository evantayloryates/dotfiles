#!/usr/bin/env bash
set -euo pipefail

# Command line for the record-screen engine (see ../cli.mjs for commands).
# Resolves node explicitly: GUI-launched processes inherit a minimal PATH.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/../../lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
. "${SCRIPT_DIR}/../lib/reader-dependencies.sh"
exec "$NODE" "${SCRIPT_DIR}/../cli.mjs" "$@"
