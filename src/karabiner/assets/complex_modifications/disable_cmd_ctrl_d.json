{
  "title": "Disable Cmd+Ctrl+D Lookup",
  "rules": [
    {
      "description": "Disable Cmd+Ctrl+D",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ]
        }
      ]
    }
  ]
}
