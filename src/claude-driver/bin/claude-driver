#!/usr/bin/env bash
set -euo pipefail

# CLI for claude-driver: every MCP tool as a subcommand, plus preflight,
# probe, broker and install. See ../README.md.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/../../lib/resolve-binary.sh"
NODE="$(resolve_binary node)"
exec "$NODE" "${SCRIPT_DIR}/../cli.mjs" "$@"
