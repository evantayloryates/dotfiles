#!/bin/zsh
# theo-air: headless control of the MacBook Air over SSH, using the Air's own tools.
#   theo-air shot [out.png]        full-res screenshot of the Air console (Retina px); also writes <out>-half.png in points
#   theo-air click <x> <y>         click at POINT coords (as seen in the -half image)   | rclick / dclick likewise
#   theo-air type "<text>"         type text            | theo-air key <combo>   e.g. cmd+space, return, esc, cmd+shift+g
#   theo-air open <App>            launch/raise an app  | theo-air osa '<applescript>'  run AppleScript on the Air
#   theo-air sh '<command>'        arbitrary shell on the Air (zsh)
#   theo-air grant <svc> <path>    grant a privacy permission directly (SIP off): accessibility|screen|fda|listen|automation:<bundle>
#   theo-air perms                 list non-Apple privacy grants on the Air
#   theo-air status                one-screen health: power, console, services, worker, calls, disk, tailscale, grants
#   theo-air tidy                  leave the Air inert: quit System Settings, close Finder windows, clear banners, then a verification shot
set -euo pipefail
H=theo-air; CL=/opt/homebrew/bin/cliclick; OUTDIR=$HOME/.local/state/switchboard/screens; mkdir -p $OUTDIR
cmd=${1:-help}; shift || true
case $cmd in
  shot)  out=${1:-$OUTDIR/air-$(date +%H%M%S).png}
         ssh -o BatchMode=yes $H 'screencapture -x /tmp/theo-shot.png && cat /tmp/theo-shot.png' > "$out"
         sips -Z 1470 "$out" --out "${out%.png}-half.png" >/dev/null 2>&1; echo "$out (half: ${out%.png}-half.png)";;
  click)  ssh -o BatchMode=yes $H "$CL c:$1,$2";;
  rclick) ssh -o BatchMode=yes $H "$CL rc:$1,$2";;
  dclick) ssh -o BatchMode=yes $H "$CL dc:$1,$2";;
  move)   ssh -o BatchMode=yes $H "$CL m:$1,$2";;
  type)   ssh -o BatchMode=yes $H "$CL t:$(printf %q "$1")";;
  key)    k=$1; mods=""; main=$k
          if [[ $k == *+* ]]; then mods=${k%+*}; main=${k##*+}; fi
          if [[ -n $mods ]]; then ssh -o BatchMode=yes $H "$CL kd:$mods kp:$main ku:$mods"; else ssh -o BatchMode=yes $H "$CL kp:$main"; fi;;
  open)   ssh -o BatchMode=yes $H "open -a $(printf %q "$1")";;
  osa)    ssh -o BatchMode=yes $H "osascript -e $(printf %q "$1")";;
  sh)     ssh -o BatchMode=yes $H "$1";;
  grant)  ssh -o BatchMode=yes $H "/usr/local/bin/tcc-grant $1 $(printf %q "$2") ${3:-}";;   # theo-air grant accessibility /path | grant automation:com.apple.MobileSMS /usr/libexec/sshd-keygen-wrapper
  perms)  ssh -o BatchMode=yes $H 'echo "== system"; sudo sqlite3 "/Library/Application Support/com.apple.TCC/TCC.db" "select service,client,auth_value from access where client not like \"com.apple.%\" order by client,service;"; echo "== user"; sqlite3 "$HOME/Library/Application Support/com.apple.TCC/TCC.db" "select service,client,indirect_object_identifier,auth_value from access;" 2>/dev/null';;
  tidy)   ssh -o BatchMode=yes $H 'osascript -e "quit app \"System Settings\"" 2>/dev/null; osascript -e "tell application \"Finder\" to close every window" 2>/dev/null; killall NotificationCenter 2>/dev/null; sleep 2; echo "tidy: settings=$(pgrep -x "System Settings" >/dev/null && echo open || echo quit) banners cleared"'
          "$0" shot "$OUTDIR/air-tidy-$(date +%H%M%S).png";;
  status) ssh -o BatchMode=yes $H 'eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null
            echo "host: $(hostname) $(ipconfig getifaddr en0) macOS $(sw_vers -productVersion) up $(uptime | sed "s/.*up //; s/,.*//")"
            echo "power: $(pmset -g batt | tail -1 | tr -s " " | cut -c1-60) | sleep=$(pmset -g | awk "/^ sleep/{print \$2}") disp=$(pmset -g | awk "/^ displaysleep/{print \$2}") SleepDisabled=$(pmset -g | awk "/SleepDisabled/{print \$2}")"
            echo "console: $(who | awk "/console/{print \$1}") | autologin=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null) | SIP: $(csrutil status | grep -oE "enabled|disabled")"
            for s in me.taylor.switchboard.agent me.taylor.switchboard.caffeinate; do st=$(launchctl print gui/$(id -u)/$s 2>/dev/null | grep -m1 -E "^[[:space:]]*state = " | sed -E "s/.*state = //"); echo "launchd $s: ${st:-not loaded}"; done
            echo "theo worker: $(grep -c "registered worker" ~/.local/state/switchboard/agent.log 2>/dev/null) registrations | last log: $(tail -1 ~/.local/state/switchboard/agent.log 2>/dev/null | cut -c1-90)"
            echo "calls: $(grep -c call_start ~/.local/state/switchboard/calls.jsonl 2>/dev/null) total | last: $(grep call_start ~/.local/state/switchboard/calls.jsonl 2>/dev/null | tail -1 | cut -c1-100)"
            echo "disk: $(df -h / | tail -1 | awk "{print \$4\" free\"}") | tailscale: $(pgrep -x Tailscale >/dev/null && echo app-running || echo app-not-running)$(ls /var/run/tailscaled.socket 2>/dev/null | grep -q . && echo ,daemon || echo ,no-daemon)"
            echo "sshd privacy grants: $(sudo sqlite3 "/Library/Application Support/com.apple.TCC/TCC.db" "select service||\"=\"||auth_value from access where client like \"%sshd-keygen-wrapper%\";" | sed "s/kTCCService//g" | tr "\n" " ")"';;
  *)      sed -n 2,10p "$0";;
esac
