#!/bin/zsh
# theo-vnc: open (or focus) a Screen Sharing window to the Air's console over the tailnet, fitted to the Air's display.
#   theo vnc            open or focus; scaling on; window sized to the Air's 1470x956 desktop (+ toolbar)
#   theo vnc --fit      only re-fit the existing window
# Login is silent once the Keychain holds a "Network Password" for the host (account theo, protocol vnc),
# readable by Screen Sharing.app. `theo vnc --check` reports whether that item exists.
set -u
HOST=${THEO_VNC_HOST:-theo-air.taile8fdd0.ts.net}
USER_=${THEO_VNC_USER:-theo}
W=${THEO_VNC_W:-1470}; H=${THEO_VNC_H:-1008}   # Air desktop 1470x956 points + Screen Sharing toolbar
APP="Screen Sharing"

have_window() {
  osascript -e "tell application \"System Events\" to tell process \"$APP\" to count (windows whose name is \"theo-air\")" 2>/dev/null
}

fit() {
  osascript <<EOF >/dev/null 2>&1
tell application "System Events" to tell process "$APP"
  set frontmost to true
  try
    if exists menu item "Turn Scaling On" of menu "View" of menu bar 1 then click menu item "Turn Scaling On" of menu "View" of menu bar 1
  end try
  delay 0.3
  set w to first window whose name is "theo-air"
  set size of w to {$W, $H}
  perform action "AXRaise" of w
  return ""
end tell
EOF
}

case ${1:-} in
  --check)
    if security find-internet-password -s "$HOST" -a "$USER_" >/dev/null 2>&1; then
      echo "keychain: Network Password for $USER_@$HOST present (silent login)"
    else
      echo "keychain: no item for $USER_@$HOST; Screen Sharing will prompt (tick 'Remember this password in my keychain')"; exit 1
    fi; exit 0 ;;
  --fit) fit; exit $? ;;
esac

if [[ "$(have_window)" == <1-> ]]; then
  fit
  echo "focused: $APP → $HOST"
  exit 0
fi

dismiss_type_prompt() {
  # macOS 15+: "Select Screen Sharing Type" (Standard / High Performance). Standard is preselected; press Continue.
  osascript <<EOF 2>/dev/null
tell application "System Events" to tell process "$APP"
  repeat with w in windows
    if exists (static text 1 of w whose value contains "Screen Sharing Type") then
      click button "Continue" of w
      return "dismissed"
    end if
  end repeat
  return ""
end tell
EOF
}

open "vnc://$USER_@$HOST"
for i in {1..60}; do
  sleep 0.5
  [[ "$(dismiss_type_prompt)" == dismissed ]] && echo "type prompt: chose Standard"
  [[ "$(have_window)" == <1-> ]] && break
done
if [[ "$(have_window)" != <1-> ]]; then
  echo "no Screen Sharing window appeared in 20 s (login prompt still up, or host unreachable: $HOST)" >&2; exit 1
fi
# Screen Sharing restores its saved window frame a moment after connecting, so fit twice. If the display is too small
# for ${W}x${H} the app keeps the Air's aspect ratio at the largest size that fits (e.g. 1377x948 on the built-in screen).
sleep 1.5; fit; sleep 1.5; fit
sz=$(osascript -e "tell application \"System Events\" to tell process \"$APP\" to get size of first window whose name is \"theo-air\"" 2>/dev/null | tr -d ' ')
echo "opened: $APP → $HOST (${sz:-?}, scaling on)"
