#!/bin/zsh
# theo-vnc: open (or focus) a Screen Sharing window to the Air's console over the tailnet, already fitted.
#   theo vnc            focus the window if it exists, else connect; returns as soon as the window is up (~1 s)
#   theo vnc --fit      re-fit the window to the Air's aspect at its current height (after a manual resize)
#   theo vnc --check    report the silent-login Keychain item and the two Screen Sharing defaults
#
# Why it is fast: no resize after connecting. Two app defaults do the fitting up front:
#   shouldScaleScreen = 1            new sessions open scaled, sized to the remote's aspect and clamped to the screen
#                                    (1378x948 on the built-in display, 1470x1008 on the ultrawide); the app flips this
#                                    back to 0 if you choose View > Turn Scaling Off, so it is re-asserted on every run
#   DontQuitWhenLastWindowCloses = 1 closing the window leaves the app resident, so the next connect skips app launch
# Silent login: a Keychain "Network Password" item for theo@HOST (protocol vnc, ACL Screen Sharing.app).
# No type prompt: the Air's server has hostSettings.preventHighPerformanceConnections = 1 (see README).
set -u
HOST=${THEO_VNC_HOST:-theo-air.taile8fdd0.ts.net}
USER_=${THEO_VNC_USER:-theo}
APP="Screen Sharing"; DOM=com.apple.ScreenSharing
RW=1470; RH=956; TOOLBAR=52   # the Air's desktop in points; Screen Sharing title + toolbar height

ss() { osascript -e "tell application \"System Events\" to tell process \"$APP\" to $1" 2>/dev/null; }
nwin() { pgrep -qx "$APP" || { echo 0; return; }; ss 'count (windows whose name is "theo-air")'; }   # System Events stalls ~1.8 s on a process that is not running

hide_quick_terminal() {
  # Run from Ghostty's quick terminal (cmd+space), the panel would stay on top while Screen Sharing takes the keyboard,
  # and cmd+space would then go to the Air instead of toggling the panel. Hide it first, but only if it is showing:
  # toggle_quick_terminal is a toggle, and the visible panel is Ghostty's one AXFloatingWindow.
  pgrep -qx ghostty || return 0
  osascript >/dev/null 2>&1 <<EOF
tell application "System Events" to tell process "Ghostty"
  if (count (windows whose subrole is "AXFloatingWindow")) = 0 then return
end tell
tell application "Ghostty" to perform action "toggle_quick_terminal" on first terminal
EOF
}

assert_defaults() {
  [[ "$(defaults read $DOM shouldScaleScreen 2>/dev/null)" == 1 ]] || defaults write $DOM shouldScaleScreen -bool true
  [[ "$(defaults read $DOM DontQuitWhenLastWindowCloses 2>/dev/null)" == 1 ]] || defaults write $DOM DontQuitWhenLastWindowCloses -bool true
}

focus() {
  osascript >/dev/null 2>&1 <<EOF
tell application "$APP" to activate
tell application "System Events" to tell process "$APP"
  set w to first window whose name is "theo-air"
  try
    set value of attribute "AXMinimized" of w to false
  end try
  perform action "AXRaise" of w
end tell
EOF
}

fit() {
  osascript >/dev/null 2>&1 <<EOF
tell application "System Events" to tell process "$APP"
  try
    if exists menu item "Turn Scaling On" of menu "View" of menu bar 1 then click menu item "Turn Scaling On" of menu "View" of menu bar 1
  end try
  set w to first window whose name is "theo-air"
  set {ww, wh} to size of w
  set ch to wh - $TOOLBAR
  set size of w to {(round (ch * $RW / $RH)), wh}
end tell
EOF
}

case ${1:-} in
  --check)
    security find-internet-password -s "$HOST" -a "$USER_" >/dev/null 2>&1 \
      && echo "keychain: login for $USER_@$HOST present (silent)" || echo "keychain: no login for $USER_@$HOST (Screen Sharing will prompt)"
    echo "defaults: shouldScaleScreen=$(defaults read $DOM shouldScaleScreen 2>/dev/null) DontQuitWhenLastWindowCloses=$(defaults read $DOM DontQuitWhenLastWindowCloses 2>/dev/null)"
    exit 0 ;;
  --fit) fit; ss 'get size of (first window whose name is "theo-air")'; exit 0 ;;
esac

assert_defaults
hide_quick_terminal
if [[ "$(nwin)" == <1-> ]]; then focus; echo "focused: $APP → $HOST"; exit 0; fi

zmodload zsh/datetime; t0=$EPOCHREALTIME
open "vnc://$USER_@$HOST"
# One AppleScript waits for the window (checking the process exists first), answers the type prompt if it ever shows,
# raises the window and returns its size: no per-poll process spawns.
res=$(osascript 2>/dev/null <<EOF
tell application "System Events"
  repeat 400 times
    if exists process "$APP" then
      tell process "$APP"
        if (count (windows whose name is "theo-air")) > 0 then
          set w to first window whose name is "theo-air"
          set frontmost to true
          perform action "AXRaise" of w
          set {a, b} to size of w
          return (a as text) & "x" & (b as text)
        end if
        repeat with x in windows
          try
            if exists (static text 1 of x whose value contains "Screen Sharing Type") then click button "Continue" of x
          end try
        end repeat
      end tell
    end if
    delay 0.05
  end repeat
end tell
return "timeout"
EOF
)
if [[ "$res" != *x* ]]; then
  echo "no Screen Sharing window after 20 s (login prompt up, or $HOST unreachable over the tailnet)" >&2; exit 1
fi
printf "opened: %s → %s in %.1fs (%s)\n" "$APP" "$HOST" $(( EPOCHREALTIME - t0 )) "$res"
