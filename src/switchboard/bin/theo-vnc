#!/Users/taylor/.local/share/uv/tools/vncdotool/bin/python
"""theo-vnc: headless control of the MacBook Air "theo-air" over VNC (macOS Screen Sharing, VNC password mode).
Password is read from 1Password at run time (vault Theo, item "theo macbook air VNC") and never touches argv.
  theo-vnc capture <out.png>          screenshot of the Air
  theo-vnc click <x> <y> [button]     click at screen coords (1 left, 3 right)
  theo-vnc dblclick <x> <y>
  theo-vnc move <x> <y>
  theo-vnc type "<text>"              type text
  theo-vnc key <keysym>               e.g. enter, esc, cmd-space, cmd-q
  theo-vnc keys <k1> <k2> ...         several keys in order
"""
import os, subprocess, sys
from vncdotool import api, rfb
# macOS offers Apple's DH auth (30) ahead of VNC password (2) and vncdotool picks the highest; force the VNC-password path.
rfb.RFBClient.SUPPORTED_AUTHS = {rfb.AuthTypes.NONE, rfb.AuthTypes.VNC_AUTHENTICATION}

HOST = os.environ.get("THEO_AIR_HOST", "theo-air.local")
def password():
    env = dict(os.environ, OP_BROKER_CALLER="theo-vnc")
    r = subprocess.run(["/Users/taylor/dotfiles/bin/op", "read", "--account", "7VFHSPIKIVERNPF7AU5VCUIJII",
                        "op://Theo/7ylkrktxspyela5zkwpegbg4au/credential"], capture_output=True, text=True, env=env)
    if r.returncode != 0:
        sys.exit(f"op read failed (exit {r.returncode}): broker unavailable or not authorized")
    return r.stdout.strip()

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    cmd, args = argv[0], argv[1:]
    c = api.connect(HOST, password=password(), timeout=15)
    try:
        if cmd == "capture": c.captureScreen(args[0]); print(f"captured {args[0]}")
        elif cmd == "click": c.mouseMove(int(args[0]), int(args[1])); c.mousePress(int(args[2]) if len(args) > 2 else 1); print("clicked")
        elif cmd == "dblclick": c.mouseMove(int(args[0]), int(args[1])); c.mousePress(1); c.mousePress(1); print("double-clicked")
        elif cmd == "move": c.mouseMove(int(args[0]), int(args[1])); print("moved")
        elif cmd == "type": c.type(args[0]); print("typed")
        elif cmd == "key": c.keyPress(args[0]); print("pressed", args[0])
        elif cmd == "keys":
            for k in args: c.keyPress(k)
            print("pressed", *args)
        else: sys.exit(f"unknown command {cmd}")
    finally:
        c.disconnect(); api.shutdown()
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
