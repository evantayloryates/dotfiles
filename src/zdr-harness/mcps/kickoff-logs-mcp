#!/usr/bin/env bash
set -euo pipefail

# Launcher for the harness-only kickoff-logs MCP server. The harness runs this
# inside its isolated environment and passes the AWS credentials through
# opencode.json, so nothing is read from ~/.aws here and no other MCP client
# should ever be pointed at this script. See ../README.md.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
. "${SCRIPT_DIR}/../../lib/resolve-binary.sh"

NODE="$(resolve_binary node)"

exec "$NODE" "${SCRIPT_DIR}/kickoff-logs/index.mjs"
