# Kickoff ZDR harness secrets. Mode 600. Never committed.
#
# APPROVED USE: the zero-data-retention harness only, i.e. the
# com.taylor.zdr-harness LaunchAgent running src/zdr-harness/bin/zdr-harness.
# Do NOT copy these values into another agent harness, MCP client, shell
# profile, CI job or repo .env, and do not paste them into a chat.
#
# The analytics tokens below reach Kickoff production data. The entire point of
# this harness is that only a model covered by zero data retention ever sees
# that data, and that only aggregates leave it. A token used anywhere else
# sends the same data into a context with no such guarantee. If another tool
# needs analytics access, mint a separate token for it rather than reusing one
# of these, and expect it to be revoked if it shows up outside the harness.
#
# This file's layout must match src/zdr-harness/.env.template in the dotfiles
# repo; the template carries the same keys and comments with empty values.

# OpenAI API key for Kickoff's ZDR project. 1Password: kudos-fit, Employee,
# KICKOFF_OPENAI_API_KEY. Must not equal the personal OPENAI_API_KEY.
KICKOFF_OPENAI_ZDR_API_KEY=
# HTTP Basic password for http://127.0.0.1:4096 (username: opencode).
# 1Password: kudos-fit, Employee, ZDR_HARNESS_PASSWORD.
ZDR_HARNESS_PASSWORD=
# BugSnag personal auth token. Sent as `Authorization: token ...`; BugSnag
# rejects the Bearer scheme. Full access, so the harness allowlist is what
# keeps the model to read-only tools.
KICKOFF_BUGSNAG_TOKEN=
# PostHog personal API key, read-scoped (no *:write). Sent as
# `Authorization: Bearer ...` to mcp.posthog.com, pinned to Kickoff Production.
KICKOFF_POSTHOG_TOKEN=

# AWS keys for the kickoff-logs MCP: IAM user zdr-harness-logs, read-only on
# production Lambda log groups (policy of record: src/zdr-harness/iam/zdr-harness-logs-policy.json).
# Optional: leave empty and the harness runs without CloudWatch access.
KICKOFF_ZDR_AWS_ACCESS_KEY_ID=
KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY=
# Defaults to us-west-1 when empty.
KICKOFF_ZDR_AWS_REGION=

# Cloudinary (Kickoff account) for the read-only asset MCP. 1Password: personal
# account, Kickoff vault, item "KICKOFF_CLOUDINARY_TOKEN: Root" — `key id` is
# the API key, `credential` the API secret, and the cloud name comes from the
# CLOUDINARY_URL in its notes. This is the ROOT key: it can write, and only the
# tool allowlist in opencode.json stops it. The sibling "…: Restricted" item is
# scoped read-only but returns no asset rows, which is why it is not used.
KICKOFF_CLOUDINARY_CLOUD_NAME=
KICKOFF_CLOUDINARY_API_KEY=
KICKOFF_CLOUDINARY_TOKEN=

# OpenAI Admin key (Settings -> Organization -> Admin keys, scope api.usage.read)
# used only by `bin/zdr-spend` to read org cost buckets. Optional: everything
# else works without it. It is deliberately NOT passed into the harness
# environment — it can read every project's usage, which is the blast radius the
# harness exists to avoid. Ordinary project keys get 403 on that API.
KICKOFF_OPENAI_ADMIN_KEY=

# LIVE production MySQL, read-only, for the kickoff-db MCP. 1Password: personal
# account, Kickoff vault, item KICKOFF_ZDR_DB_URL (the `url` field); source of
# truth is SSM parameter mysql-url-production-read-encrypted. User kudos_ro has
# SELECT + SHOW VIEW on kudos_production only, on the read replica. Every row is
# a real person: this URL belongs in the ZDR harness and nowhere else.
KICKOFF_ZDR_DB_URL=
# The replica is private. The harness reaches it through an SSM port-forward
# via the Kickoff Bastion (`zdr-harness tunnel start`); this is the local port.
KICKOFF_ZDR_DB_TUNNEL_PORT=33306

# Slack bot token for "Field Notes" (read-only app; 1Password personal
# account, Kickoff vault, item "Field Notes Slack Bot", field `bot token`). Reads only
# channels the bot has been invited to: coach support conversations, which are
# client PHI. This token belongs in the ZDR harness and nowhere else.
KICKOFF_SLACK_ZDR_BOT_TOKEN=
