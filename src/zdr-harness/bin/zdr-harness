#!/usr/bin/env bash
set -euo pipefail

# Dedicated zero-data-retention (ZDR) agent harness: a locked-down OpenCode
# server that only ever runs on Kickoff's ZDR OpenAI key and only exposes the
# Amplitude and BugSnag MCP servers. See ../README.md.
#
# Isolation is done with the environment, not just config: OpenCode reads
# $HOME/.opencode, $XDG_CONFIG_HOME/opencode and ~/.claude, and the launchd
# session carries a personal, non-ZDR OPENAI_API_KEY. So everything runs under
# `env -i` with a private HOME and XDG dirs under ~/.zdr-harness.
#
# Config is passed as a single FILE (OPENCODE_CONFIG), never as a config dir.
# OpenCode runs a background `npm install @opencode-ai/plugin` in every config
# directory it can write to, and has no flag to turn that off. The only config
# dir left in play is ~/.zdr-harness/xdg/config/opencode, which is kept
# read-only (chmod 555) so that install is skipped.

readonly OPENCODE_VERSION="1.18.31"
readonly PORT=4096
readonly URL="http://127.0.0.1:${PORT}"
readonly LABEL="com.taylor.zdr-harness"

ZH="${HOME}/.zdr-harness"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
# Secrets live beside the config, gitignored, with .env.template as the tracked
# shape. ~/.zdr-harness/.env is only a fallback for checkouts that never had one.
SECRETS_FILE="${PROJECT_DIR}/.env"
[[ -f "$SECRETS_FILE" ]] || SECRETS_FILE="${ZH}/.env"
RUN_DIR="${ZH}/run"
SERVE_MARKER="${RUN_DIR}/serve-started"
CONFIG_FILE="$(cd "${SCRIPT_DIR}/../opencode" && pwd -P)/opencode.json"
GLOBAL_CONFIG_DIR="${ZH}/xdg/config/opencode"
DOTFILES_SRC="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
OPENCODE_BIN="${ZH}/opt/node_modules/opencode-ai/bin/opencode.exe"

. "${DOTFILES_SRC}/lib/read-env.sh"

die() {
  printf 'zdr-harness: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: zdr-harness <command>

  serve            Run the server on ${URL} (launchd runs this)
  attach           Open the TUI against the running server
  status           Health, MCP connection state and the web UI URL
  restart          Restart the launchd service
  reload-auth      Re-read the secrets file into the server (restart), then
                   report fingerprints and probe each token against its API
  logs             Tail the service logs
  prune [--days N] [--db-days M] [--dry-run]
                   Delete sessions not updated in N days (default 14), and
                   sessions that used the production database after M days
                   (default 7). The memory store is never pruned.
  tunnel start|stop|status
                   SSM port-forward to the production read replica via the
                   Kickoff Bastion, under the harness's own AWS key. With the
                   com.taylor.zdr-harness-tunnel LaunchAgent loaded, start and
                   stop go through launchd (start --foreground is its entry point)
  app              Build ZDR Harness.app if stale, install it to ~/Applications, open it
  app-build [--force]
                   Build and install the app without opening it
  set-token <KEY>  Replace one secret in ~/.zdr-harness/.env, restart, re-check.
                   Reads the value from a hidden prompt or stdin, never argv,
                   and prints only a fingerprint.
  mcp <args>       Pass through to 'opencode mcp' (e.g. mcp auth amplitude)
  <anything else>  Pass through to opencode inside the isolated environment
EOF
}

load_secrets() {
  [[ -f "$SECRETS_FILE" ]] ||
    die "no secrets file: expected ${PROJECT_DIR}/.env (copy .env.template) or ${ZH}/.env"
  local secrets
  # BugSnag and PostHog use long-lived read-scoped tokens instead of OAuth;
  # opencode.json references them as {env:...}. Keys are named one by one: a
  # blanket source would hand every secret in the file to OpenCode.
  secrets="$(ENV_FILE="$SECRETS_FILE" env_export \
    KICKOFF_OPENAI_ZDR_API_KEY ZDR_HARNESS_PASSWORD KICKOFF_BUGSNAG_TOKEN KICKOFF_POSTHOG_TOKEN)" ||
    die "${SECRETS_FILE} is missing keys; see ${PROJECT_DIR}/.env.template"
  eval "$secrets"
  unset secrets
  : "${KICKOFF_OPENAI_ZDR_API_KEY:?KICKOFF_OPENAI_ZDR_API_KEY must be set in $SECRETS_FILE}"
  : "${ZDR_HARNESS_PASSWORD:?ZDR_HARNESS_PASSWORD must be set in $SECRETS_FILE}"
  : "${KICKOFF_BUGSNAG_TOKEN:?KICKOFF_BUGSNAG_TOKEN must be set in $SECRETS_FILE}"
  : "${KICKOFF_POSTHOG_TOKEN:?KICKOFF_POSTHOG_TOKEN must be set in $SECRETS_FILE}"

  # AWS keys for the kickoff-logs MCP are optional: the harness runs without
  # them and that server reports the missing credential when a tool is called.
  KICKOFF_ZDR_AWS_ACCESS_KEY_ID="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_ZDR_AWS_ACCESS_KEY_ID 2>/dev/null || true)"
  KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY 2>/dev/null || true)"
  KICKOFF_ZDR_AWS_REGION="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_ZDR_AWS_REGION 2>/dev/null || true)"

  # Production database (read replica through the SSM tunnel). Optional: without
  # the URL that server reports the missing key.
  KICKOFF_ZDR_DB_URL="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_ZDR_DB_URL 2>/dev/null || true)"
  KICKOFF_ZDR_DB_TUNNEL_PORT="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_ZDR_DB_TUNNEL_PORT 2>/dev/null || true)"
  KICKOFF_ZDR_DB_TUNNEL_PORT="${KICKOFF_ZDR_DB_TUNNEL_PORT:-33306}"

  # Slack (Field Notes bot). Optional: without it that server reports the missing token.
  KICKOFF_SLACK_ZDR_BOT_TOKEN="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_SLACK_ZDR_BOT_TOKEN 2>/dev/null || true)"

  # Cloudinary is optional too: without it that server reports the missing key.
  KICKOFF_CLOUDINARY_CLOUD_NAME="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_CLOUDINARY_CLOUD_NAME 2>/dev/null || true)"
  KICKOFF_CLOUDINARY_API_KEY="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_CLOUDINARY_API_KEY 2>/dev/null || true)"
  KICKOFF_CLOUDINARY_TOKEN="$(ENV_FILE="$SECRETS_FILE" env_get KICKOFF_CLOUDINARY_TOKEN 2>/dev/null || true)"
}

preflight() {
  [[ -x "$OPENCODE_BIN" ]] ||
    die "OpenCode not installed; run: npm i --prefix ${ZH}/opt opencode-ai@${OPENCODE_VERSION}"
  # Managed config overrides every other source, so its presence would silently
  # replace this harness's lockdown.
  [[ ! -e "/Library/Application Support/opencode" ]] ||
    die "managed OpenCode config exists at /Library/Application Support/opencode; refusing"
  # Stored provider auth outranks OPENAI_API_KEY from the environment.
  [[ ! -e "${ZH}/xdg/data/opencode/auth.json" ]] ||
    die "${ZH}/xdg/data/opencode/auth.json exists; stored auth would override the ZDR key; refusing"

  # The personal key in dotfiles/.env is not ZDR. Never let it stand in.
  local personal=""
  personal="$(ENV_FILE="${DOTFILES_DIR:-$HOME/dotfiles}/.env" env_get OPENAI_API_KEY 2>/dev/null)" || true
  [[ -z "$personal" || "$personal" != "$KICKOFF_OPENAI_ZDR_API_KEY" ]] ||
    die "KICKOFF_OPENAI_ZDR_API_KEY equals the personal OPENAI_API_KEY; refusing"
  unset personal

  # A writable config dir triggers OpenCode's background npm install.
  [[ ! -w "$GLOBAL_CONFIG_DIR" ]] ||
    die "${GLOBAL_CONFIG_DIR} is writable; run: chmod 555 ${GLOBAL_CONFIG_DIR}"
  [[ ! -e "${ZH}/home/.opencode" ]] ||
    die "${ZH}/home/.opencode exists; it would be loaded as an extra config dir; refusing"

  local version
  version="$(isolated_env "$OPENCODE_BIN" --version 2>/dev/null)" || true
  [[ "$version" == "$OPENCODE_VERSION" ]] ||
    die "expected OpenCode ${OPENCODE_VERSION}, found '${version}'; upgrade deliberately (see README)"
}

# The sessions DB holds raw tool output, and OpenCode creates it 644 inside a
# 755 directory. Tighten on every start rather than refusing, since OpenCode
# recreates these files itself. Same-uid processes can still read them; this
# stops other accounts and makes the intent explicit.
protect_state() {
  local data_dir="${ZH}/xdg/data/opencode"
  [[ -d "$data_dir" ]] || return 0
  chmod 700 "$data_dir" 2>/dev/null || true
  chmod 600 "$data_dir"/opencode.db* 2>/dev/null || true
  chmod -R go-rwx "${ZH}/xdg/data" 2>/dev/null || true
}

# Run a command with nothing inherited except the variables named here.
# ISOLATED_EXEC=exec replaces this shell, so launchd signals reach OpenCode.
isolated_env() {
  ${ISOLATED_EXEC:-} env -i \
    HOME="${ZH}/home" \
    PATH="${ZH}/opt/node_modules/.bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    TMPDIR="${ZH}/tmp" \
    LANG=en_US.UTF-8 \
    ${TERM:+TERM="$TERM"} \
    ${COLORTERM:+COLORTERM="$COLORTERM"} \
    XDG_CONFIG_HOME="${ZH}/xdg/config" \
    XDG_DATA_HOME="${ZH}/xdg/data" \
    XDG_CACHE_HOME="${ZH}/xdg/cache" \
    XDG_STATE_HOME="${ZH}/xdg/state" \
    OPENCODE_CONFIG="$CONFIG_FILE" \
    OPENAI_API_KEY="$KICKOFF_OPENAI_ZDR_API_KEY" \
    KICKOFF_BUGSNAG_TOKEN="$KICKOFF_BUGSNAG_TOKEN" \
    KICKOFF_POSTHOG_TOKEN="$KICKOFF_POSTHOG_TOKEN" \
    ZDR_HARNESS_LOGS_MCP="${PROJECT_DIR}/mcps/kickoff-logs-mcp" \
    ZDR_HARNESS_MEMORY_MCP="${PROJECT_DIR}/mcps/harness-memory-mcp" \
    ZDR_MEMORY_DIR="${ZH}/memory" \
    ZDR_HARNESS_CLOUDINARY_MCP="${PROJECT_DIR}/mcps/cloudinary-mcp" \
    ZDR_HARNESS_DB_MCP="${PROJECT_DIR}/mcps/kickoff-db-mcp" \
    ZDR_HARNESS_SLACK_MCP="${PROJECT_DIR}/mcps/kickoff-slack-mcp" \
    KICKOFF_SLACK_ZDR_BOT_TOKEN="${KICKOFF_SLACK_ZDR_BOT_TOKEN:-}" \
    KICKOFF_ZDR_DB_URL="${KICKOFF_ZDR_DB_URL:-}" \
    KICKOFF_ZDR_DB_TUNNEL_PORT="${KICKOFF_ZDR_DB_TUNNEL_PORT:-33306}" \
    KICKOFF_CLOUDINARY_CLOUD_NAME="${KICKOFF_CLOUDINARY_CLOUD_NAME:-}" \
    KICKOFF_CLOUDINARY_API_KEY="${KICKOFF_CLOUDINARY_API_KEY:-}" \
    KICKOFF_CLOUDINARY_TOKEN="${KICKOFF_CLOUDINARY_TOKEN:-}" \
    KICKOFF_ZDR_AWS_ACCESS_KEY_ID="${KICKOFF_ZDR_AWS_ACCESS_KEY_ID:-}" \
    KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY="${KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY:-}" \
    KICKOFF_ZDR_AWS_REGION="${KICKOFF_ZDR_AWS_REGION:-us-west-1}" \
    OPENCODE_SERVER_USERNAME=opencode \
    OPENCODE_SERVER_PASSWORD="$ZDR_HARNESS_PASSWORD" \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_SHARE=1 \
    OPENCODE_DISABLE_CLAUDE_CODE=1 \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
    OPENCODE_DISABLE_EXTERNAL_SKILLS=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    "$@"
}

run_opencode() {
  load_secrets
  preflight
  cd "${ZH}/work"
  ISOLATED_EXEC=exec isolated_env "$OPENCODE_BIN" "$@"
}

# Authenticated GET against the running server. The password goes to curl on
# stdin, never on the command line where `ps` could see it.
api_get() {
  printf 'user = "opencode:%s"\n' "$ZDR_HARNESS_PASSWORD" |
    curl -sS --fail-with-body -K - \
      -H "x-opencode-directory: ${ZH}/work" \
      "${URL}$1"
}

api_delete() {
  printf 'user = "opencode:%s"\n' "$ZDR_HARNESS_PASSWORD" |
    curl -sS --fail-with-body -o /dev/null -X DELETE -K - \
      -H "x-opencode-directory: ${ZH}/work" \
      "${URL}$1"
}

# Sessions hold raw Amplitude and BugSnag tool output, so old ones go. Ones
# that touched the production database hold rows and transcript text, so they
# go sooner (--db-days, default 7).
prune() {
  local days=14 db_days=7 dry_run=0
  while (($#)); do
    case "$1" in
      --days) days="${2:-}"; shift 2 ;;
      --db-days) db_days="${2:-}"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      *) die "prune: unknown argument '$1'" ;;
    esac
  done
  [[ "$days" =~ ^[0-9]+$ && "$db_days" =~ ^[0-9]+$ ]] || die "prune: --days and --db-days need whole numbers"
  load_secrets

  # Root sessions only: deleting a parent removes its children. Sessions in the
  # db window but not the general one are checked for kickoffdb_* tool parts.
  local candidates
  candidates="$(api_get /session | DAYS="$days" DB_DAYS="$db_days" /usr/bin/python3 -c '
import json, os, sys, time
days, db_days = int(os.environ["DAYS"]), int(os.environ["DB_DAYS"])
now = time.time() * 1000
sessions = [s for s in json.load(sys.stdin) if not s.get("parentID")]
sys.stderr.write("%d root sessions\n" % len(sessions))
for s in sessions:
    age = (now - s["time"]["updated"]) / 86400000
    if age >= days: print("old", s["id"], s["time"]["updated"], json.dumps(s.get("title", "")[:80]))
    elif age >= db_days: print("check", s["id"], s["time"]["updated"], json.dumps(s.get("title", "")[:80]))
')" || die "prune: could not list sessions"

  local ids="" kind id updated title
  while read -r kind id updated title; do
    [[ "$id" =~ ^ses_[A-Za-z0-9]+$ ]] || continue
    if [[ "$kind" == check ]]; then
      api_get "/session/${id}/message" | /usr/bin/python3 -c '
import json, sys
parts = (p for m in json.load(sys.stdin) for p in m.get("parts", []))
sys.exit(0 if any(p.get("type") == "tool" and str(p.get("tool", "")).startswith("kickoffdb_") for p in parts) else 1)
' 2>/dev/null || continue
      kind="db"
    fi
    if ((dry_run)); then
      printf '  would delete %s  %s  %-3s %s\n' "$id" "$(date -r $((updated / 1000)) '+%Y-%m-%d')" "$kind" "$title" >&2
    fi
    ids+="$id "
  done <<<"$candidates"

  ((dry_run)) && return 0
  local id deleted=0 failed=0
  for id in $ids; do
    [[ "$id" =~ ^ses_[A-Za-z0-9]+$ ]] || { failed=$((failed + 1)); continue; }
    if api_delete "/session/${id}"; then deleted=$((deleted + 1)); else failed=$((failed + 1)); fi
  done
  printf 'deleted %d, failed %d\n' "$deleted" "$failed"
  ((failed == 0))
}

# Settable keys come from the tracked template, so adding a key there is enough
# and this list cannot drift behind it.
secret_keys() {
  grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "${PROJECT_DIR}/.env.template" 2>/dev/null | sed 's/=$//' | tr '\n' ' '
}

# Rewrite one line of ~/.zdr-harness/.env. The value never reaches argv, where
# `ps` would show it, and is never echoed; the only feedback is a length and a
# SHA-256 prefix, which is enough to tell whether the edit landed. Hand-editing
# the file is how a rolled token silently fails to reach the running server.
set_token() {
  local key="${1:-}" keys
  keys="$(secret_keys)"
  case " ${keys} " in
    *" ${key} "*) ;;
    *) die "usage: zdr-harness set-token <$(echo "$keys" | tr ' ' '|' | sed 's/|$//')>" ;;
  esac
  [[ -f "$SECRETS_FILE" ]] || die "no secrets file; start from ${PROJECT_DIR}/.env.template"

  local value=""
  if [[ -t 0 ]]; then
    read -rsp "${key} (input hidden): " value
    printf '\n'
  else
    IFS= read -r value || true
  fi
  [[ -n "$value" ]] || die "empty value; ${SECRETS_FILE} unchanged"

  SET_KEY="$key" SET_VALUE="$value" /usr/bin/python3 "${SCRIPT_DIR}/../set-env-value.py" "$SECRETS_FILE"
  unset value

  printf '\nRestarting so the running server picks it up.\n'
  launchctl kickstart -k "gui/$(id -u)/${LABEL}"
  local i
  for i in $(seq 1 30); do
    sleep 2
    api_get /global/health 2>/dev/null | grep -q '"healthy":true' && break
  done
  load_secrets
  printf '\nhealth: '
  api_get /global/health
  printf '\nmcp:    '
  api_get /mcp
  printf '\n\nNote: `connected` only means the server answered. Ask one real question\nper server to prove the credential itself works.\n'
}

# Print which secrets file is live and a fingerprint per key, never a value.
# Fingerprints are how you tell whether an edit actually reached the server.
secrets_report() {
  SECRETS_PATH="$SECRETS_FILE" MARKER="$SERVE_MARKER" /usr/bin/python3 - <<'PY'
import hashlib, os
from pathlib import Path

path = Path(os.environ["SECRETS_PATH"])
marker = Path(os.environ["MARKER"])
print(f"secrets: {path}")
for raw in path.read_text().splitlines():
    line = raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    if line.startswith("export "):
        line = line[len("export "):].strip()
    key, value = line.split("=", 1)
    value = value.strip().strip('"').strip("'")
    digest = hashlib.sha256(value.encode()).hexdigest()[:12] if value else "EMPTY"
    print(f"  {key.strip()}: len={len(value)} sha12={digest}")
if marker.exists() and path.stat().st_mtime > marker.stat().st_mtime:
    print("STALE: edited after the server started. Run: zdr-harness reload-auth")
PY
}

# Prove a credential rather than trusting `connected`: both times a token broke,
# /mcp stayed green and the failure only showed up inside a tool result.
probe_credentials() {
  local code
  printf 'header = "Authorization: token %s"\n' "$KICKOFF_BUGSNAG_TOKEN" |
    curl -sS -m 20 -K - -o /dev/null -w '%{http_code}' -H 'X-Version: 2' \
      https://api.bugsnag.com/user/organizations >/tmp/.zdr-probe-bugsnag 2>/dev/null || true
  code="$(cat /tmp/.zdr-probe-bugsnag 2>/dev/null)"
  rm -f /tmp/.zdr-probe-bugsnag
  printf '  bugsnag token:  HTTP %s %s\n' "${code:-000}" "$([[ "$code" == 200 ]] && echo OK || echo FAILED)"

  printf 'header = "Authorization: Bearer %s"\n' "$KICKOFF_POSTHOG_TOKEN" |
    curl -sS -m 20 -K - -o /dev/null -w '%{http_code}' \
      https://us.posthog.com/api/users/@me/ >/tmp/.zdr-probe-posthog 2>/dev/null || true
  code="$(cat /tmp/.zdr-probe-posthog 2>/dev/null)"
  rm -f /tmp/.zdr-probe-posthog
  printf '  posthog token:  HTTP %s %s\n' "${code:-000}" "$([[ "$code" == 200 ]] && echo OK || echo FAILED)"
  printf '  amplitude:      OAuth, not a token; see /mcp status above\n'

  # A read that a restricted key also passes proves nothing, so probe the one
  # endpoint only the root key answers.
  if [[ -n "${KICKOFF_CLOUDINARY_TOKEN:-}" ]]; then
    printf 'url = "https://api.cloudinary.com/v1_1/%s/resources/image?max_results=1"\nuser = "%s:%s"\n' \
      "$KICKOFF_CLOUDINARY_CLOUD_NAME" "$KICKOFF_CLOUDINARY_API_KEY" "$KICKOFF_CLOUDINARY_TOKEN" |
      curl -sS -m 20 -K - -o /tmp/.zdr-probe-cloudinary-body -w '%{http_code}' \
        >/tmp/.zdr-probe-cloudinary 2>/dev/null || true
    code="$(cat /tmp/.zdr-probe-cloudinary 2>/dev/null)"
    local rows
    rows="$(/usr/bin/python3 -c 'import json,sys
try: print(len(json.load(open("/tmp/.zdr-probe-cloudinary-body")).get("resources",[])))
except Exception: print(0)' 2>/dev/null)"
    rm -f /tmp/.zdr-probe-cloudinary /tmp/.zdr-probe-cloudinary-body
    if [[ "$code" == 200 && "${rows:-0}" -gt 0 ]]; then
      printf '  cloudinary:     HTTP 200 OK (asset rows readable)\n'
    elif [[ "$code" == 200 ]]; then
      printf '  cloudinary:     HTTP 200 but no asset rows — this is the restricted key, not the root one\n'
    else
      printf '  cloudinary:     HTTP %s FAILED\n' "${code:-000}"
    fi
  else
    printf '  cloudinary:     no key set (KICKOFF_CLOUDINARY_TOKEN empty)\n'
  fi

  if [[ -n "${KICKOFF_SLACK_ZDR_BOT_TOKEN:-}" ]]; then
    printf 'header = "Authorization: Bearer %s"\n' "$KICKOFF_SLACK_ZDR_BOT_TOKEN" |
      curl -sS -m 20 -K - -D /tmp/.zdr-probe-slack-h -o /tmp/.zdr-probe-slack https://slack.com/api/auth.test 2>/dev/null || true
    local slack_ok slack_scopes
    slack_ok="$(/usr/bin/python3 -c 'import json;d=json.load(open("/tmp/.zdr-probe-slack"));print("ok" if d.get("ok") else d.get("error","?"))' 2>/dev/null || echo '?')"
    slack_scopes="$(grep -i '^x-oauth-scopes:' /tmp/.zdr-probe-slack-h 2>/dev/null | cut -d' ' -f2- | tr -d '\r')"
    rm -f /tmp/.zdr-probe-slack /tmp/.zdr-probe-slack-h
    if [[ "$slack_ok" == ok ]]; then
      case "$slack_scopes" in *write*|*post*|*admin*) printf '  slack bot:      OK but scopes include a write scope (%s) — the app must stay read-only\n' "$slack_scopes" ;;
        *) printf '  slack bot:      OK (scopes: %s)\n' "$slack_scopes" ;; esac
    else
      printf '  slack bot:      FAILED %s\n' "$slack_ok"
    fi
  else
    printf '  slack bot:      no token set (KICKOFF_SLACK_ZDR_BOT_TOKEN empty)\n'
  fi

  # The logs credential is proven through the MCP server itself, so the probe
  # exercises the same signing path the harness uses.
  if [[ -n "${KICKOFF_ZDR_AWS_ACCESS_KEY_ID:-}" ]]; then
    local out
    out="$(printf '%s\n' \
      '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"probe","version":"1"}}}' \
      '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"list_groups","arguments":{"limit":1}}}' |
      KICKOFF_ZDR_AWS_ACCESS_KEY_ID="$KICKOFF_ZDR_AWS_ACCESS_KEY_ID" \
      KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY="$KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY" \
      KICKOFF_ZDR_AWS_REGION="${KICKOFF_ZDR_AWS_REGION:-us-west-1}" \
      timeout 40 "${PROJECT_DIR}/mcps/kickoff-logs-mcp" 2>/dev/null | tail -1)"
    if [[ "$out" == *'"isError":false'* ]]; then
      printf '  aws logs:       OK\n'
    else
      printf '  aws logs:       FAILED %s\n' "$(printf '%s' "$out" | tr -d '\n' | cut -c1-160)"
    fi
  else
    printf '  aws logs:       no key set (KICKOFF_ZDR_AWS_ACCESS_KEY_ID empty)\n'
  fi

  # The database is proven through its MCP server too, so the probe exercises
  # the tunnel, TLS verification and the read-only session the harness uses.
  if [[ -n "${KICKOFF_ZDR_DB_URL:-}" ]]; then
    if ! tunnel_port_open; then
      printf '  prod db:        tunnel closed on 127.0.0.1:%s (zdr-harness tunnel start)\n' "$KICKOFF_ZDR_DB_TUNNEL_PORT"
    else
      local dbout
      dbout="$(printf '%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"probe","version":"1"}}}' \
        '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"query","arguments":{"sql":"SELECT CURRENT_USER() AS u, @@read_only AS ro, @@session.transaction_read_only AS tro"}}}' |
        KICKOFF_ZDR_DB_URL="$KICKOFF_ZDR_DB_URL" KICKOFF_ZDR_DB_TUNNEL_PORT="$KICKOFF_ZDR_DB_TUNNEL_PORT" \
        HOME="${ZH}/home" timeout 40 "${PROJECT_DIR}/mcps/kickoff-db-mcp" 2>/dev/null | tail -1)"
      if [[ "$dbout" == *'"isError":false'* && "$dbout" == *'kudos_ro'* ]]; then
        printf '  prod db:        OK (kudos_ro on the read replica, read_only=1)\n'
      else
        printf '  prod db:        FAILED %s\n' "$(printf '%s' "$dbout" | tr -d '\n' | cut -c1-200)"
      fi
    fi
  else
    printf '  prod db:        no URL set (KICKOFF_ZDR_DB_URL empty)\n'
  fi
}

# The production read replica is private. The only way in is an SSM port-forward
# through the Kickoff Bastion, which is the one host its security group admits.
# This runs that session under the harness's own AWS key (never the admin
# profile), so the tunnel has exactly the rights the IAM policy of record grants.
TUNNEL_TARGET_INSTANCE="i-00b905df66752344d"
TUNNEL_REMOTE_HOST="kickoff-production-mysql-read.c65ds0rqtugh.us-west-1.rds.amazonaws.com"
TUNNEL_PID_FILE="${ZH}/run/tunnel.pid"
TUNNEL_LOG="${ZH}/logs/tunnel.log"
TUNNEL_LABEL="com.taylor.zdr-harness-tunnel"

# True when the tunnel LaunchAgent is bootstrapped for this user; then launchd
# owns the session and start/stop go through it rather than a nohup child.
tunnel_launchd_loaded() {
  launchctl print "gui/$(id -u)/${TUNNEL_LABEL}" >/dev/null 2>&1
}

tunnel_env_check() {
  [[ -n "${KICKOFF_ZDR_AWS_ACCESS_KEY_ID:-}" ]] || die "tunnel: KICKOFF_ZDR_AWS_ACCESS_KEY_ID is empty"
  AWS_BIN="$(command -v aws || ls /opt/homebrew/bin/aws /usr/local/bin/aws 2>/dev/null | head -1)"
  [[ -n "$AWS_BIN" ]] || die "tunnel: aws CLI not found"
  command -v session-manager-plugin >/dev/null || [[ -x /opt/homebrew/bin/session-manager-plugin ]] || die "tunnel: session-manager-plugin not found"
}

# The session itself. In the foreground this replaces the shell, so launchd
# supervises the aws process directly and sees it exit when SSM drops the
# session. Only the harness key: no profile, no ~/.aws files, so a laptop
# admin credential can never be picked up by accident.
tunnel_session() {
  local mode="$1"
  tunnel_env_check
  mkdir -p "$RUN_DIR" "${ZH}/logs"
  local -a cmd=(
    env -u AWS_PROFILE -u AWS_SESSION_TOKEN
      AWS_ACCESS_KEY_ID="$KICKOFF_ZDR_AWS_ACCESS_KEY_ID" AWS_SECRET_ACCESS_KEY="$KICKOFF_ZDR_AWS_SECRET_ACCESS_KEY"
      AWS_DEFAULT_REGION="${KICKOFF_ZDR_AWS_REGION:-us-west-1}" AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null
      PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
      "$AWS_BIN" ssm start-session --target "$TUNNEL_TARGET_INSTANCE"
        --document-name AWS-StartPortForwardingSessionToRemoteHost
        --parameters "{\"host\":[\"$TUNNEL_REMOTE_HOST\"],\"portNumber\":[\"3306\"],\"localPortNumber\":[\"$KICKOFF_ZDR_DB_TUNNEL_PORT\"]}"
  )
  if [[ "$mode" == foreground ]]; then
    printf '%s tunnel: opening 127.0.0.1:%s via %s\n' "$(date '+%F %T')" "$KICKOFF_ZDR_DB_TUNNEL_PORT" "$TUNNEL_TARGET_INSTANCE"
    exec "${cmd[@]}"
  fi
  nohup "${cmd[@]}" >>"$TUNNEL_LOG" 2>&1 &
  printf '%s' "$!" > "$TUNNEL_PID_FILE"
}

tunnel_pid() {
  local pid
  pid="$(cat "$TUNNEL_PID_FILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

tunnel_port_open() {
  /usr/bin/nc -z 127.0.0.1 "$KICKOFF_ZDR_DB_TUNNEL_PORT" >/dev/null 2>&1
}

# The process listening on the port (session-manager-plugin, a child of aws).
tunnel_listener() {
  /usr/sbin/lsof -nP -iTCP:"$KICKOFF_ZDR_DB_TUNNEL_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1
}

# launchd's pid for the tunnel job, when it is running.
tunnel_launchd_pid() {
  launchctl print "gui/$(id -u)/${TUNNEL_LABEL}" 2>/dev/null | sed -n 's/^[[:space:]]*pid = \([0-9]*\).*/\1/p' | head -1
}

# Who holds the port: "launchd", "pid N" for a nohup child, "orphan" for a
# session-manager-plugin whose aws parent is gone, or "other".
tunnel_owner() {
  local lpid ppid lname
  lpid="$(tunnel_listener)"; [[ -n "$lpid" ]] || { printf 'none'; return; }
  ppid="$(ps -o ppid= -p "$lpid" 2>/dev/null | tr -d ' ')"
  lname="$(ps -o comm= -p "$lpid" 2>/dev/null)"
  if [[ -n "$ppid" && "$ppid" == "$(tunnel_launchd_pid)" ]]; then printf 'launchd'
  elif [[ -n "$ppid" && "$ppid" == "$(tunnel_pid || true)" ]]; then printf 'pid %s' "$ppid"
  elif [[ "$lname" == *session-manager-plugin* && "$ppid" == 1 ]]; then printf 'orphan'
  else printf 'other (%s pid %s)' "$lname" "$lpid"; fi
}

# Killing aws alone leaves its session-manager-plugin child holding the port;
# take the child too, then anything orphaned on the port from an earlier run.
tunnel_kill_tree() {
  local pid="$1"
  pkill -TERM -P "$pid" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
  sleep 1
  if [[ "$(tunnel_owner)" == orphan ]]; then kill "$(tunnel_listener)" 2>/dev/null || true; sleep 1; fi
}

tunnel() {
  load_secrets
  local cmd="${1:-status}"
  case "$cmd" in
    status)
      if tunnel_port_open; then
        local owner; owner="$(tunnel_owner)"
        [[ "$owner" == launchd ]] && owner="launchd (${TUNNEL_LABEL})"
        printf 'tunnel: 127.0.0.1:%s is open, %s\n' "$KICKOFF_ZDR_DB_TUNNEL_PORT" "$owner"
        [[ "$owner" == orphan ]] && printf 'tunnel: that is a leftover plugin process; run: zdr-harness tunnel start\n'
      else
        printf 'tunnel: 127.0.0.1:%s is closed (%s)\n' "$KICKOFF_ZDR_DB_TUNNEL_PORT" "$(tunnel_launchd_loaded && echo 'launchd will retry' || echo 'zdr-harness tunnel start')"
        return 1
      fi
      ;;
    start)
      if [[ "${2:-}" == --foreground ]]; then
        # launchd's entry point. A leftover plugin from an earlier manual run
        # is ours to clear; anything else holding the port means wait and let
        # ThrottleInterval retry.
        if [[ "$(tunnel_owner)" == orphan ]]; then
          printf '%s tunnel: clearing an orphaned plugin on port %s\n' "$(date '+%F %T')" "$KICKOFF_ZDR_DB_TUNNEL_PORT"
          kill "$(tunnel_listener)" 2>/dev/null || true; sleep 1
        fi
        if tunnel_port_open; then printf '%s tunnel: port %s held by %s; retrying later\n' "$(date '+%F %T')" "$KICKOFF_ZDR_DB_TUNNEL_PORT" "$(tunnel_owner)"; exit 0; fi
        tunnel_session foreground
      fi
      if [[ "$(tunnel_owner)" == orphan ]]; then kill "$(tunnel_listener)" 2>/dev/null || true; sleep 1; fi
      if tunnel_port_open; then printf 'tunnel: already open on %s (%s)\n' "$KICKOFF_ZDR_DB_TUNNEL_PORT" "$(tunnel_owner)"; return 0; fi
      if tunnel_launchd_loaded; then
        launchctl kickstart "gui/$(id -u)/${TUNNEL_LABEL}"
      else
        tunnel_session background
      fi
      local i
      for i in $(seq 1 20); do tunnel_port_open && break; sleep 1; done
      if tunnel_port_open; then tunnel status
      else printf 'tunnel: failed to open; last log lines:\n' >&2; tail -n 5 "$TUNNEL_LOG" >&2; return 1; fi
      ;;
    stop)
      if tunnel_launchd_loaded; then
        launchctl bootout "gui/$(id -u)/${TUNNEL_LABEL}"
        printf 'tunnel: %s unloaded (KeepAlive off). Reload with: launchctl bootstrap gui/%s ~/Library/LaunchAgents/%s.plist\n' "$TUNNEL_LABEL" "$(id -u)" "$TUNNEL_LABEL"
        return 0
      fi
      local pid; pid="$(tunnel_pid || true)"
      if [[ -n "$pid" ]]; then tunnel_kill_tree "$pid"; rm -f "$TUNNEL_PID_FILE"; printf 'tunnel: stopped pid %s\n' "$pid"
      else rm -f "$TUNNEL_PID_FILE"; printf 'tunnel: not running under this wrapper\n'; fi
      if [[ "$(tunnel_owner)" == orphan ]]; then kill "$(tunnel_listener)" 2>/dev/null || true; printf 'tunnel: cleared an orphaned plugin\n'; fi
      ;;
    *) die "tunnel: use start [--foreground], stop or status" ;;
  esac
}

# Reflow auth: OpenCode resolves {env:...} when the server starts, so applying a
# rolled token means restarting that process. Nothing lighter exists.
reload_auth() {
  load_secrets
  secrets_report
  printf '\nrestarting the server so it re-reads them\n'
  launchctl kickstart -k "gui/$(id -u)/${LABEL}"
  local i
  for i in $(seq 1 30); do
    sleep 2
    api_get /global/health 2>/dev/null | grep -q '"healthy":true' && break
  done
  printf '\nhealth: '
  api_get /global/health
  printf '\nmcp:    '
  api_get /mcp
  printf '\n\ncredential probes (the part /mcp cannot tell you):\n'
  probe_credentials
}

case "${1:-}" in
  serve)
    shift
    mkdir -p "$RUN_DIR"
    : > "$SERVE_MARKER"
    protect_state
    run_opencode serve --hostname 127.0.0.1 --port "$PORT" "$@"
    ;;
  attach)
    shift
    run_opencode attach "$URL" --dir "${ZH}/work" "$@"
    ;;
  status)
    load_secrets
    printf 'health: '
    api_get /global/health
    printf '\nmcp:    '
    api_get /mcp
    printf '\nweb UI: %s (user: opencode, password: 1Password Employee/ZDR_HARNESS_PASSWORD)\n' "$URL"
    tunnel status || true
    printf '\n'
    secrets_report
    ;;
  restart)
    launchctl kickstart -k "gui/$(id -u)/${LABEL}"
    ;;
  logs)
    tail -n 50 -f "${ZH}/logs/stdout.log" "${ZH}/logs/stderr.log"
    ;;
  prune)
    shift
    prune "$@"
    ;;
  app-build)
    shift
    /usr/bin/python3 "${SCRIPT_DIR}/../build_app.py" --install "$@"
    ;;
  app)
    shift
    /usr/bin/python3 "${SCRIPT_DIR}/../build_app.py" --install "$@"
    open "${HOME}/Applications/ZDR Harness.app"
    ;;
  reload-auth)
    reload_auth
    ;;
  tunnel)
    shift
    tunnel "$@"
    ;;
  set-token)
    shift
    set_token "$@"
    ;;
  "" | -h | --help | help)
    usage
    ;;
  *)
    run_opencode "$@"
    ;;
esac
