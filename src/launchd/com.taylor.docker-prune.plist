<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Fires docker-prune.sh every 15 minutes; the script runs a cleanup only when
    the last successful one is 3 hours old (state in ~/.local/state/docker-prune),
    so a window missed while Docker was down, hung or the Mac asleep is caught up
    at the next fire. Safe to fire anytime. See README.md.

    NOTE: launchd does not expand ~ or $HOME in ProgramArguments, so the path is
    absolute. install.sh symlinks this file into ~/Library/LaunchAgents/.
  -->
  <key>Label</key>
  <string>com.taylor.docker-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/taylor/dotfiles/src/launchd/docker-prune.sh</string>
  </array>
  <!-- Every 15 minutes (cheap: the script exits at once unless a run is due). -->
  <key>StartInterval</key>
  <integer>900</integer>
  <!-- Also run once when the agent loads (login / re-install). -->
  <key>RunAtLoad</key>
  <true/>
  <!-- Maintenance work: low scheduling + I/O priority so it never competes with foreground tasks. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
