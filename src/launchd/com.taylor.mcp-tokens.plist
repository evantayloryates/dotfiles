<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Runs export-mcp-tokens.sh at login to bridge dotfiles/.env MCP tokens into
    the launchd user session so GUI apps (Claude desktop) inherit them.
    See README.md in this directory. Contains no secrets.

    NOTE: launchd does not expand ~ or $HOME in ProgramArguments, so the path
    is absolute. install.sh symlinks this file into ~/Library/LaunchAgents/.
  -->
  <key>Label</key>
  <string>com.taylor.mcp-tokens</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/taylor/dotfiles/src/launchd/export-mcp-tokens.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>

  <!--
    Re-run whenever .env changes. Without this the bridge is login-only, so
    editing .env leaves the launchd session (and therefore every already
    running GUI app) holding stale or missing values: on 2026-08-27 the
    session was short 8 variables and carried an outdated ROLLBAR_TOKEN
    because .env had been edited after the last login.

    WatchPaths fires on the real path, not the ~/dotfiles symlink, because
    launchd registers a kqueue on the resolved file.

    NOTE: this refreshes the launchd session only. A GUI app keeps the
    environment it was launched with, so still relaunch Claude after a
    token change.
  -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/taylor/src/github/dotfiles/.env</string>
  </array>
</dict>
</plist>
