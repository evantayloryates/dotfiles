<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Keeps the Terra webhook archive current: S3 deletes payloads after 30 days,
    so each run archives every day it has not finished, oldest first, and
    re-lists the newest 3 days for late keys. Runs are resumable and idempotent;
    a run that hits its 120-minute budget or the 15 GB free-disk floor stops
    cleanly and the next one continues. Twice a day so a missed run (asleep,
    offline) costs nothing. See src/zdr-harness/README.md "Terra archive".
    NOTE: launchd does not expand ~ or $HOME.
  -->
  <key>Label</key>
  <string>com.taylor.zdr-harness-terra-archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/taylor/src/github/dotfiles/src/zdr-harness/bin/zdr-harness</string>
    <string>terra-archive</string>
    <string>run</string>
    <string>--max-minutes</string>
    <string>120</string>
    <string>--trigger</string>
    <string>launchd</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>15</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>15</integer>
    </dict>
  </array>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/taylor/.zdr-harness/logs/terra-archive/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/taylor/.zdr-harness/logs/terra-archive/launchd.log</string>
</dict>
</plist>
