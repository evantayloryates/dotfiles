<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    smart-record capture engine (mcps/smart-record/README.md). Runs in the
    logged-in GUI session only, starts at login, restarts if it crashes.
    The bundle is built into data/ by mcps/smart-record/src/build.py and holds its
    own Screen Recording grant.

    NOTE: launchd does not expand ~ or $HOME, so paths are absolute.
  -->
  <key>Label</key>
  <string>com.taylor.smart-record</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/taylor/src/github/dotfiles/data/smart-record/smart-recordd.app/Contents/MacOS/smart-recordd</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <string>com.taylor.smart-record</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart on crash; a clean exit (e.g. a duplicate instance) stays down. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- Interactive: no background throttling of capture timing. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/taylor/.smart-record/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/taylor/.smart-record/logs/stderr.log</string>
</dict>
</plist>
